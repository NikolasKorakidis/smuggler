; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Smuggler"
run/main_scene="res://world/terrain_tile/terrain_tile.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

FlightInput="*res://systems/flight_input.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/screen_space_aa=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[editor_plugins]

enabled=PackedStringArray("res://addons/anemos/plugin.cfg")

[shader_globals]

anemos_wetness={
"type": "float",
"value": 0.0
}
anemos_cloud_shadow={
"type": "sampler2D",
"value": ""
}
anemos_cloud_shadow_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, -1e+06)
}
anemos_sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
