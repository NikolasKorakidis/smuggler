[configuration]

entry_symbol = "jsbsim_gd_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "res://bin/libjsbsim_gd.macos.template_debug.dylib"
macos.release = "res://bin/libjsbsim_gd.macos.template_release.dylib"
windows.debug.x86_64 = "res://bin/libjsbsim_gd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libjsbsim_gd.windows.template_release.x86_64.dll"
